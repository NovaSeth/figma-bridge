<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.flibrus.figma-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string><string>-lc</string>
    <string>cd "$HOME/Documents/Code/figma-bridge" &amp;&amp; node server.mjs &amp; sleep 2; cd "$HOME/Documents/Code/figma-bridge" &amp;&amp; exec node auto-agent.mjs</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/flibrus-figma-bridge.log</string>
  <key>StandardErrorPath</key><string>/tmp/flibrus-figma-bridge.err</string>
</dict>
</plist>
